{
  "name": "sln2csproj",
  "version": "0.4.0",
  "description": "Generate a fake csproj for legacy ASP.NET WebSite projects in a .sln.",
  "type": "commonjs",
  "bin": {
    "sln2csproj": "bin/cli.js"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/cli.ts",
    "gen": "node bin/cli.js",
    "pretest": "npm run build",
    "test": "node --test",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.17.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
